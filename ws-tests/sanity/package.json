{
  "name": "@opensrcs/tests-ws-sanity",
  "version": "1.0.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "author": "OpenSrcs",
  "template": "@opensrcs/default-package",
  "license": "EPL-2.0",
  "scripts": {
    "build": "compile",
    "build:watch": "compile",
    "_phase:build": "compile transpile tests",
    "_phase:test": "",
    "_phase:format": "format src",
    "_phase:validate": "compile validate",
    "lint:fix": "eslint --fix tests",
    "lint": "eslint tests",
    "format": "format tests",
    "ci": "playwright install --with-deps chromium",
    "test": "",
    "uitest": "cross-env LOCAL_URL=http://club.local:3003/ DEV_URL= playwright test -c ./tests/playwright.config.ts",
    "staging-uitest": "cross-env PLATFORM_URI=https://front.club.opensrcs.org/ playwright test -c ./tests/playwright.config.ts --grep @staging",
    "dev-uitest": "cross-env PLATFORM_URI=http://club.local:8080 PLATFORM_TRANSACTOR=ws://club.local:3333 DEV_URL=http://club.local:8080/account playwright test -c ./tests/playwright.config.ts",
    "debug": "cross-env LOCAL_URL=http://club.local:3003/ DEV_URL= playwright test -c ./tests/playwright.config.ts --debug --headed",
    "dev-debug": "cross-env PLATFORM_URI=http://club.local:8080 PLATFORM_TRANSACTOR=ws://club.local:3333 playwright test -c ./tests/playwright.config.ts --debug --headed",
    "codegen": "playwright codegen --load-storage .auth/storage.json http://club.local:8083/login/selectWorkspace",
    "codegen-admin": "playwright codegen --load-storage .auth/adminStorage.json http://club.local:8083/login/admin",
    "dev-codegen": "cross-env playwright codegen --load-storage storage-dev.json http://club.local:8080/workbench/sanity-ws/",
    "allure:generate": "allure generate allure-results -o allure-report --clean"
  },
  "devDependencies": {
    "@opensrcs/club-rig": "workspace:^1.0.0",
    "@types/jest": "^29.5.5",
    "@types/node": "^22.18.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-n": "^15.4.0",
    "eslint": "^8.54.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint-config-standard-with-typescript": "^40.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "@playwright/test": "^1.48.2",
    "allure-playwright": "^3.0.6",
    "allure-js-commons": "^3.0.6",
    "@faker-js/faker": "^8.4.1",
    "@opensrcs/tests-sanity": "workspace:^1.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "cross-env": "~7.0.3",
    "@opensrcs/core": "workspace:^1.0.0",
    "@opensrcs/client-resources": "workspace:^1.0.0"
  }
}
