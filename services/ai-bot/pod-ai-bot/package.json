    "@opensrcs/text-html": "workspace:^1.0.0",
    "@opensrcs/text-markdown": "workspace:^1.0.0",
    "@opensrcs/workbench": "workspace:^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
