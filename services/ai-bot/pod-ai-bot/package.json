    "@opensrcs/contact": "workspace:^1.0.0",
    "@opensrcs/core": "workspace:^1.0.0",
    "@opensrcs/document": "workspace:^1.0.0",
    "@opensrcs/love": "workspace:^1.0.0",
    "@opensrcs/mongo": "workspace:^1.0.0",
    "@opensrcs/notification": "workspace:^1.0.0",
    "@opensrcs/openai": "workspace:^1.0.0",
    "@opensrcs/club": "workspace:^1.0.0",
    "@opensrcs/rank": "workspace:^1.0.0",
    "@opensrcs/retry": "workspace:^1.0.0",
    "@opensrcs/server-ai-bot": "workspace:^1.0.0",
    "@opensrcs/server-client": "workspace:^1.0.0",
    "@opensrcs/server-core": "workspace:^1.0.0",
