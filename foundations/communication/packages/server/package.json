{
  "name": "@opensrcs/communication-server",
  "version": "1.0.0",
  "license": "EPL-2.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "files": [
    "lib/**/*",
    "types/**/*",
    "src/**/*",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "compile",
    "_phase:build": "compile transpile src",
    "_phase:validate": "compile validate",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\"",
    "format": "format",
    "clean": "rm -rf lib && rm -rf types rm -rf node_modules",
    "test": "jest --passWithNoTests --silent --forceExit",
    "_phase:test": "jest --passWithNoTests --silent --forceExit"
  },
  "devDependencies": {
    "@opensrcs/club-rig": "workspace:^1.0.0",
    "@types/jest": "^29.5.5",
    "@types/node": "^22.18.1",
    "@types/uuid": "^8.3.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "esbuild": "^0.25.10",
    "esbuild-plugin-copy": "~2.1.1",
    "eslint": "^8.54.0",
    "eslint-config-standard-with-typescript": "^40.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-n": "^15.4.0",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.1.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@opensrcs/account-client": "workspace:^1.0.0",
    "@opensrcs/communication-cockroach": "workspace:^1.0.0",
    "@opensrcs/communication-sdk-types": "workspace:^1.0.0",
    "@opensrcs/communication-shared": "workspace:^1.0.0",
    "@opensrcs/communication-types": "workspace:^1.0.0",
    "@opensrcs/core": "workspace:^1.0.0",
    "@opensrcs/server-token": "workspace:^1.0.0",
    "@opensrcs/text-core": "workspace:^1.0.0",
    "@opensrcs/text-markdown": "workspace:^1.0.0",
    "@opensrcs/clublake-client": "workspace:^1.0.0",
    "uuid": "^8.3.2",
    "zod": "^3.22.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opensrcs/communication.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "require": "./lib/index.js",
      "import": "./lib/index.js"
    }
  }
