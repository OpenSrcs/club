  },
  "files": [
    "lib/**/*",
    "!lib/**/__test__/**",
    "types/**/*",
    "!types/**/__test__/**",
    "src/**/*",
    "!src/**/__test__/**",
    "tsconfig.json"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "require": "./lib/index.js",
      "import": "./lib/index.js"
