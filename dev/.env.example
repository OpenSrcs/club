STORAGE_CONFIG="datalake|http://club.local:4030"
MONGO_URL=mongodb://mongodb:27017?compressors=snappy
DB_URL_PG=postgres://postgres:postgres@postgres:5432/postgres
BACKUP_STORAGE_CONFIG="minio|minio?accessKey=minioadmin&secretKey=minioadmin"
BACKUP_BUCKET_NAME=dev-backups
DB_CR_URL=postgresql://root@club.local:26257/defaultdb?sslmode=disable
QUEUE_CONFIG=redpanda:9092

# ── Already referenced in docker-compose.yaml via ${VAR} but never set ──
# CLUB_ADMIN_EMAILS=
# POSTHOG_API_KEY=
# POSTHOG_HOST=

# ── Sign-in OAuth providers (consumed by the `account` service) ──
# "Sign in with Google" — create at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Also used by the `gmail`/`calendar` sync pods (same Google OAuth app, broader scopes)
# "Sign in with GitHub" — create at https://github.com/settings/developers (OAuth App, NOT a GitHub App)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_DISPLAY_NAME=
# Generic OIDC provider
# OPENID_CLIENT_ID=
# OPENID_CLIENT_SECRET=
# OPENID_ISSUER=
# OPENID_DISPLAY_NAME=

# ── GitHub App integration (`github` service — issue/PR sync, NOT the OAuth login above) ──
# Create at https://github.com/settings/apps
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_ENTERPRISE_HOSTNAME=

# ── Outbound mail (`mail` / `mail-worker` / `calendar-mailer` services) ──
# Either SMTP...
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# ...or AWS SES (leave SMTP_* empty if using this instead)
# SES_ACCESS_KEY=
# SES_SECRET_KEY=
# SES_REGION=

# ── Payment (`payment` service) — optional, starts fine without these ──
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=
# POLAR_ORGANIZATION_ID=

# ── Telegram bot (`telegram-bot` service) — also needs MongoDB added to the stack ──
# TELEGRAM_BOT_TOKEN=

# ── club-ai-agent (not yet wired into docker-compose.yaml) ──
# Driven by a baked-in src/config.yml, with these leaf values overridable via env
# vars using an AGENT_ prefix + "__" for nesting (e.g. AGENT_CLUB__BASE_URL overrides
# the "club: base_url:" key in that YAML).
#
# LLM provider — model string like "anthropic/claude-sonnet-4"; provider is one of
# OpenAI | OpenRouter | Anthropic
# AGENT_MODEL=
# AGENT_PROVIDER=
# AGENT_PROVIDER_API_KEY=
# VoyageAI (embeddings for the memory/semantic-search system) — required, not optional.
# Get a key at https://dash.voyageai.com
# AGENT_VOYAGEAI_API_KEY=
# AGENT_VOYAGEAI_MODEL=
# The club instance this agent logs into — inside docker-compose use the internal
# service address (http://front:8080), not http://localhost:8087
# AGENT_CLUB__BASE_URL=
# Real club account this agent authenticates as (agent_mode: employee in config.yml)
# AGENT_AGENT_MODE__EMAIL=
# AGENT_AGENT_MODE__PASSWORD=
# Brave Search API key (web_search tool) — optional, get at https://brave.com/search/api/
# AGENT_WEB_SEARCH__API_KEY=

# ── Web push (`notification` service) ──
# Generate a VAPID pair with: npx web-push generate-vapid-keys
# PUSH_PUBLIC_KEY=
# PUSH_PRIVATE_KEY=
PUSH_SUBJECT=mailto:admin@club.local

# ── LiveKit (`love` / virtual office) ──
# docker-compose.full.yaml starts a dev LiveKit server; these match its keys.
# Point them at a LiveKit Cloud project to use a real SFU instead.
LIVEKIT_HOST=http://club.local:7880
LIVEKIT_WS=ws://club.local:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret

# ── OpenAI (`ai-bot`, `translate`) ──
# translate REQUIRES this and will not start without it (it is behind the `ai`
# profile for exactly that reason). ai-bot starts without it but cannot answer.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# ── ai-bot extras (all optional) ──
# DATALAB_API_KEY=
# DEEPGRAM_API_KEY=
# DEEPGRAM_PROJECT_ID=

# ── Gmail / Calendar sync (`google` profile) ──
# GMAIL_CREDENTIALS is a single-line JSON blob of the Google OAuth client. It
# reaches the container as the env var `Credentials` - note the unusual
# non-uppercase name, that is what the service actually reads.
# GMAIL_CREDENTIALS=
# GMAIL_WATCH_TOPIC_NAME=
# CALENDAR_WATCH_URL=

# ── GitHub App (`github` profile) ──
# The @-less bot handle of your GitHub App, e.g. club-dev-bot
# GITHUB_BOT_NAME=

# ── Telegram bot (`telegram` profile) ──
TELEGRAM_BOT_DOMAIN=club.local
# Public https URL of the bot, surfaced in the client. Empty hides the entry.
# TELEGRAM_BOT_URL=

# ── SMTP extras ──
# Defaults to the local mailpit sink in docker-compose.full.yaml.
SMTP_TLS_MODE=ignore
SMTP_URL=smtp://mailpit:1025

# ── Payment / billing (docker-compose.ext.yaml) ──
PAYMENT_USE_SANDBOX=true
# STRIPE_SUBSCRIPTION_PLANS=
# POLAR_SUBSCRIPTION_PLANS=

# ── Paddle Billing (`payment` service, `payment` profile) ──
# Merchant-of-record alternative to Stripe/Polar. The payment service tries
# Polar, then Stripe, then Paddle, and uses the first fully-configured one.
#
# PADDLE_API_KEY is environment-specific: a sandbox key only works with
# USE_SANDBOX/PAYMENT_USE_SANDBOX=true, a live key only with it false.
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# Maps club plans to Paddle price ids ('pri_...'), same format as the other
# providers: "plan@type:priceId;plan@type:priceId". All four tiers are required.
# PADDLE_SUBSCRIPTION_PLANS=common@tier:pri_xxx;rare@tier:pri_xxx;epic@tier:pri_xxx;legendary@tier:pri_xxx
#
# Paddle also needs a default payment link set under Checkout > Settings in the
# dashboard, otherwise it returns no hosted checkout URL and the service errors.
#
# When a cancellation takes effect: 'next_billing_period' (default) or
# 'immediately'. Immediate cancellation is terminal in Paddle, so uncancel
# stops working for those subscriptions.
PADDLE_CANCEL_EFFECTIVE_FROM=next_billing_period
